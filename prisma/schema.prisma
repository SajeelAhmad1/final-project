generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  password          String?       
  verified          Boolean       @default(false)
  isPasswordSet     Boolean       @default(false)
  isProfileComplete Boolean       @default(false)
  loginType         String?
  role              Role          @default(STUDENT) // Add default value here
  faculty           Faculty?
  student           Student?
  notifications     Notification[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Faculty {
  id          String    @id @default(uuid())
  firstName   String
  lastName   String
  department  String
  designation String
  imageUrl    String?
  phone       String?
  user        User      @relation(fields: [userId], references: [id]) // Only here
  userId      String    @unique
  courses     Course[]
  leaves      Leave[]   @relation("LeaveRequester")
  substituteLeaves Leave[] @relation("LeaveSubstitute")
  invigilations Exam[]  @relation("ExamInvigilator")
  createdAt   DateTime  @default(now())
}

model Student {
  id          String    @id @default(uuid())
  firstName   String
  lastName   String
  rollNumber  String    @unique
  batch       String
  phone             String
  imageUrl          String?
  streetAddress     String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  department  String
  user        User      @relation(fields: [userId], references: [id]) // Only here
  userId      String    @unique
  enrollments Enrollment[]
  seatings    Seating[]
  createdAt   DateTime  @default(now())

  @@index([rollNumber])
  @@index([department, batch])
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime @map("expires_at")
}

model Course {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  department   String
  credits      Int
  faculty      Faculty?   @relation(fields: [facultyId], references: [id])
  facultyId    String?
  classes      Class[]
  enrollments Enrollment[]
  exams        Exam[]
  createdAt    DateTime   @default(now())
}

model Class {
  id          String     @id @default(uuid())
  course      Course     @relation(fields: [courseId], references: [id])
  courseId    String
  section     Section?   @relation(fields: [sectionId], references: [id])
  sectionId   String?
  room        Room?      @relation(fields: [roomId], references: [id])
  roomId      String?
  startTime   DateTime?
  endTime     DateTime?
  dayOfWeek   String?
  preferredDay String?
  status      String     @default("UNSCHEDULED")
  recurring   Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

model Session {
  id          String     @id @default(uuid())
  year        String     @unique // e.g., "2021"
  sections    Section[]
  createdAt   DateTime   @default(now())
}

model Section {
  id          String     @id @default(uuid())
  name        String     // e.g., "A", "B", "C"
  session     Session    @relation(fields: [sessionId], references: [id])
  sessionId   String
  classes     Class[]
  createdAt   DateTime   @default(now())
  
  @@unique([name, sessionId])
}

model Room {
  id          String     @id @default(uuid())
  name        String     @unique
  capacity    Int
  type        RoomType
  classes     Class[]
  exams       Exam[]
  resources   Resource[]
  createdAt   DateTime   @default(now())
}

enum RoomType {
  LECTURE_HALL
  LAB
  EXAM_HALL
}

model Resource {
  id          String     @id @default(uuid())
  name        String
  type        String
  room        Room       @relation(fields: [roomId], references: [id])
  roomId      String
  createdAt   DateTime   @default(now())
}

model Exam {
  id          String     @id @default(uuid())
  course      Course     @relation(fields: [courseId], references: [id])
  courseId    String
  date        DateTime
  duration    Int
  room        Room       @relation(fields: [roomId], references: [id])
  roomId      String
  seating     Seating[]
  invigilator Faculty?   @relation("ExamInvigilator", fields: [invigilatorId], references: [id])
  invigilatorId String?
  createdAt   DateTime   @default(now())
}

model Seating {
  id          String     @id @default(uuid())
  exam        Exam       @relation(fields: [examId], references: [id])
  examId      String
  student     Student    @relation(fields: [studentId], references: [id])
  studentId   String
  seatNumber  String
  batch       String     // Add these fields explicitly
  department  String
  merit       Int?
  createdAt   DateTime   @default(now())
}

model Leave {
  id          String     @id @default(uuid())
  faculty     Faculty    @relation("LeaveRequester", fields: [facultyId], references: [id])
  facultyId   String
  startDate   DateTime
  endDate     DateTime
  reason      String
  substitute  Faculty?   @relation("LeaveSubstitute", fields: [substituteId], references: [id])
  substituteId String?
  status      LeaveStatus @default(PENDING)
  createdAt   DateTime   @default(now())
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  title       String
  message     String
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model Enrollment {
  id          String   @id @default(uuid())
  student     Student  @relation(fields: [studentId], references: [id])
  studentId   String
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String
  semester    String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, courseId, semester])
}